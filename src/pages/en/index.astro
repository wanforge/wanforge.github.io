---
import Layout from '../../layouts/Layout.astro';
import { getAssetPath } from '../../config/paths';
import {
  Hero,
  LogoCloudSection,
  FeaturesOverview,
  HowItWorks,
  StatsSection,
  IntegrationsSection,
  TestimonialsSection,
  PricingPreview,
  FAQSection,
  FinalCTA,
} from '../../components/sections';
import { wanforgeFaqs } from '../../data/wanforge';
---

<Layout
  title="WANFORGE — Engineering & Product Studio"
  description="WANFORGE builds web products, applications, infrastructure, automation, and integrated systems for real operational needs."
  locale="en"
  preloadImages={[
    {
      href: getAssetPath('images/dashboard-mockup.svg'),
      fetchpriority: 'high',
      as: 'image',
      type: 'image/svg+xml',
    },
  ]}
>
  {/* 1. Hero Section */}
  <Hero client:load transition:persist locale="en" />

  {/* 2. Logo Cloud Section */}
  <LogoCloudSection client:load transition:persist title="Trusted Engineering Technologies" />

  {/* 3. Features Overview Section */}
  <FeaturesOverview client:load transition:persist locale="en" />

  {/* 4. How It Works Section */}
  <HowItWorks client:load transition:persist locale="en" />

  {/* 5. Statistics Section */}
  <StatsSection client:load transition:persist locale="en" />

  {/* 6. Integrations Section */}
  <IntegrationsSection client:load transition:persist locale="en" />

  {/* 7. Testimonials Section */}
  <TestimonialsSection
    client:load
    transition:persist
    title="Field Validations & Trust"
    subtitle="Real-world system deployment across clinical EMRs, cooperative ERPs, and corporate portals."
  />

  {/* 8. Pricing Preview Section */}
  <PricingPreview
    client:load
    transition:persist
    heading="Engineering Collaboration Models"
    subheading="Clear, transparent engagements tailored to your operational scale and technical specifications."
    showToggle={false}
  />

  {/* 9. FAQ Section */}
  <FAQSection
    client:load
    transition:persist
    heading="Frequently Asked Questions"
    subheading="Key insights into WANFORGE engineering workflows, data confidentiality, and system operations."
    faqs={wanforgeFaqs.en}
  />

  {/* 10. Final CTA Section */}
  <FinalCTA
    client:load
    transition:persist
    title="Ready to Engineer Reliable Systems?"
    description="Discuss your operational requirements. We engineer, automate, and deploy systems that work."
    primaryButton={{ text: 'Start via WhatsApp', href: 'https://wa.me/62816658056' }}
    secondaryButton={{ text: 'Explore WanForge GitHub', href: 'https://github.com/wanforge' }}
  />
</Layout>
