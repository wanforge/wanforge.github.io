---
import Layout from '../layouts/Layout.astro';
import { getAssetPath } from '../config/paths';
import {
  Hero,
  LogoCloudSection,
  FeaturesOverview,
  HowItWorks,
  StatsSection,
  IntegrationsSection,
  TestimonialsSection,
  PricingPreview,
  FAQSection,
  FinalCTA,
} from '../components/sections';
import { wanforgeFaqs } from '../data/wanforge';
---

<Layout
  title="WANFORGE — Engineering & Product Studio"
  description="WANFORGE merancang produk web, aplikasi, infrastruktur, otomasi, dan sistem terintegrasi untuk kebutuhan operasional yang nyata."
  locale="id"
  preloadImages={[
    {
      href: getAssetPath('images/dashboard-mockup.svg'),
      fetchpriority: 'high',
      as: 'image',
      type: 'image/svg+xml',
    },
  ]}
>
  {/* 1. Hero Section */}
  <Hero client:load transition:persist locale="id" />

  {/* 2. Logo Cloud Section */}
  <LogoCloudSection client:load transition:persist title="Teknologi & Ekosistem Teruji" />

  {/* 3. Features Overview Section */}
  <FeaturesOverview client:load transition:persist locale="id" />

  {/* 4. How It Works Section */}
  <HowItWorks client:load transition:persist locale="id" />

  {/* 5. Statistics Section */}
  <StatsSection client:load transition:persist locale="id" />

  {/* 6. Integrations Section */}
  <IntegrationsSection client:load transition:persist locale="id" />

  {/* 7. Testimonials Section */}
  <TestimonialsSection
    client:load
    transition:persist
    title="Kepercayaan & Validasi Lapangan"
    subtitle="Pengalaman penerapan nyata di sektor klinis/SIMRS, koperasi manajemen, dan kepatuhan korporasi."
  />

  {/* 8. Pricing Preview Section */}
  <PricingPreview
    client:load
    transition:persist
    heading="Model Kolaborasi Rekayasa"
    subheading="Skema kerja sama transparan yang disesuaikan dengan skala dan kebutuhan operasional sistem Anda."
    showToggle={false}
  />

  {/* 9. FAQ Section */}
  <FAQSection
    client:load
    transition:persist
    heading="Pertanyaan yang Sering Diajukan"
    subheading="Informasi esensial mengenai alur rekayasa, keamanan, dan pemeliharaan operasional WANFORGE."
    faqs={wanforgeFaqs.id}
  />

  {/* 10. Final CTA Section */}
  <FinalCTA
    client:load
    transition:persist
    title="Siap Membangun Sistem Digital yang Andal?"
    description="Diskusikan kebutuhan operasional tim Anda. Kami siap merancang dan mengimplementasikan solusi teknis yang tepat sasaran."
    primaryButton={{ text: 'Mulai Diskusi via WhatsApp', href: 'https://wa.me/62816658056' }}
    secondaryButton={{ text: 'Lihat GitHub WanForge', href: 'https://github.com/wanforge' }}
  />
</Layout>
